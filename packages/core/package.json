{
  "name": "@campusos/core",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop workspace for ZJU students.",
  "author": "Harry-Linner",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "predev": "pnpm run rebuild:electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/repair-expect-type.mjs && vitest run",
    "test:coverage": "node ../../scripts/repair-expect-type.mjs && vitest run --coverage",
    "test:e2e": "pnpm run rebuild:electron && electron-vite build --mode e2e && playwright test",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "verify:zju-auth": "node ../../scripts/repair-expect-type.mjs && vitest run src/main/zjuUnifiedAuth.live.test.ts --reporter=verbose",
    "verify:campus-feed": "node ../../scripts/repair-expect-type.mjs && vitest run src/main/campusFeedSources.live.test.ts --reporter=verbose",
    "verify:headless-sandbox": "electron-vite build && node ../../scripts/run-headless-sandbox-smoke.mjs",
    "lint": "node ../../scripts/run-eslint.mjs packages/core && node ../../scripts/run-eslint.mjs plugins/official/academic && node ../../scripts/run-eslint.mjs plugins/official/schedule && node ../../scripts/run-eslint.mjs plugins/official/materials && node ../../scripts/run-eslint.mjs plugins/official/ai-assistant && node ../../scripts/run-eslint.mjs plugins/official/daily-brief && node ../../scripts/run-eslint.mjs plugins/official/campus-feed"
  },
  "dependencies": {
    "@campusos/plugin-academic": "workspace:*",
    "@campusos/plugin-academic-exams": "workspace:*",
    "@campusos/plugin-academic-timetable-events": "workspace:*",
    "@campusos/plugin-ai-assistant": "workspace:*",
    "@campusos/plugin-campus-feed": "workspace:*",
    "@campusos/plugin-daily-brief": "workspace:*",
    "@campusos/plugin-deadline-assistant": "workspace:*",
    "@campusos/plugin-materials": "workspace:*",
    "@campusos/plugin-schedule": "workspace:*",
    "@campusos/plugin-zju-calendar-config": "workspace:*",
    "@campusos/plugin-zju-graduate": "workspace:*",
    "@campusos/plugin-zju-learning": "workspace:*",
    "@campusos/plugin-zju-undergraduate": "workspace:*",
    "@campusos/shared": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@sentry/electron": "^7.15.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.2",
    "html2canvas": "^1.4.1",
    "koffi": "^3.1.6",
    "lucide-react": "^1.33.0",
    "lunar-typescript": "^1.8.6",
    "quickjs-emscripten-core": "0.32.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "2.1.9",
    "electron": "43.1.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
